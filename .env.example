# Copy to .env.local (gitignored) and fill in your own values.
# .env.local is never committed — see .gitignore.

# --- Backend ---
SEP_BASE_URL=http://localhost:3001
SEP_GATEWAY_URL=http://localhost:3001/v1

# --- Dev-only login helper (renderer) ---
# When both are set, the login page shows a "Use test account" button in dev mode.
# Leave empty to hide it. Use your own account, not a shared one.
VITE_SEP_TEST_EMAIL=
VITE_SEP_TEST_PASSWORD=

# --- scripts/test-auth-flow.sh ---
# SEP_EMAIL=you@example.com
# SEP_PASSWORD=
