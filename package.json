{
  "name": "sep-client",
  "version": "0.1.0",
  "description": "SEP Enterprise Client — Electron shell for the Silicon Employee Platform",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:preview": "vite --config vite.preview.config.ts --open /?preview=workspace",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "auth:smoke": "bash scripts/test-auth-flow.sh",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "test:tasks": "tsx --test electron/common/*.test.ts electron/common/platform/*.test.ts electron/controller/*.test.ts electron/data/*.test.ts electron/domain/*.test.ts electron/errors/*.test.ts electron/pi/sdk/*.test.ts electron/runtime/*.test.ts electron/service/*.test.ts",
    "test:invariants": "tsx --test electron/runtime/concurrency-invariants.test.ts electron/runtime/defect-regressions.test.ts electron/runtime/run-parts.test.ts electron/runtime/task-execution-coordinator.test.ts electron/service/employee-authorizer.test.ts electron/common/load-once.test.ts electron/controller/ipc-contract.test.ts electron/controller/app-lifecycle.test.ts electron/errors/*.test.ts",
    "poc:gw": "tsx poc/fake-gateway.ts",
    "poc:01": "tsx poc/01-sdk-import.ts",
    "poc:02": "tsx poc/02-provider.ts",
    "poc:03": "tsx poc/03-tool-call-async.ts",
    "poc:04": "tsx poc/04-failure.ts"
  },
  "dependencies": {
    "@dicebear/core": "9.4.3",
    "@dicebear/toon-head": "9.4.3",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.5.4",
    "zod": "4.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.7",
    "electron-vite": "^2.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^5.1.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "overrides": {
    "undici": "6.20.1"
  },
  "build": {
    "appId": "com.sep.client",
    "productName": "SEP Client",
    "copyright": "Copyright © 2026 Silicon Employee Platform",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
